From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <gabarrios2006@gmail.com>
Date: Tue, 27 Oct 2026 08:35:51 -0300
Subject: [PATCH] send: a list goes as type text to a person, as WhatsApp Web
 sends it

WhatsApp Web's stanza for a list to a person (captured over CDP on
2026-10-27): <message type="text">, <enc mediatype="list">, <biz><list
v="2" type="product_list"/></biz>. To a group it stays type "media"
(wa-js applyGroupListStanza).
---
 send.go                 |  13 ++-
 send_nativeflow_test.go | 192 ++++++++++++++++++++++------------------
 2 files changed, 117 insertions(+), 88 deletions(-)

diff --git a/send.go b/send.go
index 5791c69..c75efa2 100644
--- a/send.go
+++ b/send.go
@@ -939,6 +939,17 @@ func getTypeFromMessage(msg *waE2E.Message) string {
 	}
 }
 
+// chatMessageType is the <message> type for `to`. A list goes as "text" to a
+// person, as WhatsApp Web sends it (wa-js forces typeAttributeFromProtobuf to
+// "text" for a list), and as "media" with mediatype "list" to a group (wa-js
+// applyGroupListStanza), which is getTypeFromMessage's answer.
+func chatMessageType(msg *waE2E.Message, to types.JID) string {
+	if to.Server != types.GroupServer && getButtonTypeFromMessage(msg) == "list" {
+		return "text"
+	}
+	return getTypeFromMessage(msg)
+}
+
 func getMediaTypeFromMessage(msg *waE2E.Message) string {
 	switch {
 	case msg.ViewOnceMessage != nil:
@@ -1279,7 +1290,7 @@ func (cli *Client) prepareMessageNode(
 		})
 	}
 
-	msgType := getTypeFromMessage(message)
+	msgType := chatMessageType(message, to)
 	encAttrs := waBinary.Attrs{}
 	// Only include encMediaType for 1:1 messages (groups don't have a device-sent message plaintext)
 	if encMediaType := getMediaTypeFromMessage(message); dsmPlaintext != nil && encMediaType != "" {
