From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: reffehcsoibaf <290818442+reffehcsoibaf@users.noreply.github.com>
Date: Fri, 16 Oct 2026 16:06:48 -0300
Subject: [PATCH] appstate: emit events.Lock for lock chat mutations

The lock mutation (index "lock", LockChatAction) was received but
ignored, so linked-device clients could not learn that a chat was locked
or unlocked on the phone. Dispatch a Lock event like Archive, Pin and
Mute.
---
 appstate.go              | 3 +++
 types/events/appstate.go | 9 +++++++++
 2 files changed, 12 insertions(+)

diff --git a/appstate.go b/appstate.go
index ec1892c..3cb31ba 100644
--- a/appstate.go
+++ b/appstate.go
@@ -287,6 +287,9 @@ func (cli *Client) dispatchAppState(ctx context.Context, name appstate.WAPatchNa
 		if cli.Store.ChatSettings != nil {
 			storeUpdateError = cli.Store.ChatSettings.PutArchived(ctx, jid, act.GetArchived())
 		}
+	case appstate.IndexLock:
+		act := mutation.Action.GetLockChatAction()
+		eventToDispatch = &events.Lock{JID: jid, Timestamp: ts, Action: act, FromFullSync: fullSync}
 	case appstate.IndexContact:
 		act := mutation.Action.GetContactAction()
 		eventToDispatch = &events.Contact{JID: jid, Timestamp: ts, Action: act, FromFullSync: fullSync}
diff --git a/types/events/appstate.go b/types/events/appstate.go
index a608274..2b58517 100644
--- a/types/events/appstate.go
+++ b/types/events/appstate.go
@@ -91,6 +91,15 @@ type Archive struct {
 	FromFullSync bool                            // Whether the action is emitted because of a fullSync
 }
 
+// Lock is emitted when a chat is locked or unlocked (WhatsApp's "Lock chat" feature) from another device.
+type Lock struct {
+	JID       types.JID // The chat which was locked or unlocked.
+	Timestamp time.Time // The time when the (un)locking happened.
+
+	Action       *waSyncAction.LockChatAction // The current lock status of the chat.
+	FromFullSync bool                         // Whether the action is emitted because of a fullSync
+}
+
 // MarkChatAsRead is emitted when a whole chat is marked as read or unread from another device.
 type MarkChatAsRead struct {
 	JID       types.JID // The chat which was marked as read or unread.
