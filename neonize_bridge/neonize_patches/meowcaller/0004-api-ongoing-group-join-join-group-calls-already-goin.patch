+# Datasheet: `api/ongoing-group-join`
+
+Asking the server where a group call stands while this account is not in it,
+and joining that call by its id once it already goes on — WhatsApp Web's
+Calls-tab and group-chat Join, which never sends an offer.
+
+**Validation vectors:** focused Go KATs in `signaling/ongoing_group_test.go`
+(both stanzas, field for field against the capture) and
+`engine_ongoing_group_test.go` (the lobby ACK roster, and the join sequence:
+lobby query, roster installed, one `<accept>`, no preaccept).
+
+**Reference pinned at:** UNMAPPED — no Rust reference implements this. The
+ground truth is a WhatsApp Web capture (2026-10-28, WinZapp's WPPConnect
+engine, stanza recorder on `WAWebVoipSendSignalingXmpp`'s send and
+`WAWebHandleVoipCall.handleCall`; tags and attributes only, digits masked),
+capture SHA-256 `ac1a7327bfce746f1b1cfa77141cfe5f07fe19766cd8d1d83d4c83e8685ed96a`.
+
+## Reference source (verbatim — authoritative)
+
+The account created a group call, left it while another member stayed
+connected, waited, and joined again from the group chat's Join button:
+
+```text
+out <call to="<id>@call"><terminate call-id call-creator duration audio_duration/></call>
+out <call to="call"><group_call_duration call-id call-creator type="group" audio_duration/></call>
+out <call to="<id>@call" id><lobby call-id call-creator query="1"/></call>      (every 10 s while out)
+ack <ack from="<id>@call" class="call" type="lobby" id>
+      <group_info group-jid call-creator call-id transaction-id media="audio" connected-limit="32">
+        <user jid state="invited|connected|..." user_pn><device jid [platform]><capability ver="1"/>…</device></user>…
+      </group_info>
+    </ack>
+out <call to="<id>@call" id><accept call-id call-creator>
+      <audio enc="opus" rate="16000"/><net medium="2"/><encopt/><capability ver="1">7 bytes</capability>
+    </accept></call>
+in  <group_update> with the relay, <enc_rekey>, <transport> — as for any group call
+```
+
+Inside the call, `checkOngoingCalls` sends nothing; the lobby query only goes
+out for a call the account is not in. Participant states seen: `connected`,
+`outgoing` (ringing), `receipt` (the ring reached the phone), `invited`.
+
+## Go target
+
+```go
+func BuildLobbyQuery(callID string, callCreator types.JID, requestID string) (waBinary.Node, error)
+func BuildOngoingGroupJoin(callID string, callCreator types.JID, requestID string, video bool) (waBinary.Node, error)
+func (c *Client) QueryOngoingGroupCall(ctx context.Context, callID string, creator types.JID) (*OngoingGroupCall, error)
+func (c *Client) JoinOngoingGroupCall(ctx context.Context, callID string, creator types.JID, video bool) (*Call, error)
+```
+
+## Implementation notes
+
+- The lobby ACK is the same `<ack><group_info>` shape `ParseInitialGroupCallAck`
+  reads; no `group_info` means the server no longer has the call.
+- Join only when the lobby lists someone `connected` and the media type the
+  caller expects still matches; a call already held is not joined again.
+- The call entry is built like a call-link join (direction incoming, camera
+  off); a failed `<accept>` finishes the entry so no call is left behind.
+  Media starts with the `group_update` that carries the relay.
diff --git a/engine_ongoing_group.go b/engine_ongoing_group.go
new file mode 100644
index 0000000..bf7029d
--- /dev/null
+++ b/engine_ongoing_group.go
@@ -0,0 +1,156 @@
+package meowcaller
+
+import (
+	"context"
+	"errors"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+
+	"github.com/purpshell/meowcaller/signaling"
+)
+
+// OngoingGroupCall is what the server says of a group call this account can
+// join: who is in it and in which state.
+type OngoingGroupCall struct {
+	CallID   string
+	Creator  types.JID
+	GroupJID types.JID
+	Video    bool
+	State    GroupCallState
+}
+
+// Connected is how many people are in the call right now.
+func (o *OngoingGroupCall) Connected() int {
+	// Source of truth: datasheets/voip-ongoing-group-join.md (participant states)
+	if o == nil {
+		return 0
+	}
+	n := 0
+	for _, p := range o.State.Participants {
+		if p.State == "connected" {
+			n++
+		}
+	}
+	return n
+}
+
+// ErrGroupCallOver is returned when the server no longer has anyone in the call.
+var ErrGroupCallOver = errors.New("meowcaller: the group call is no longer going on")
+
+// ErrGroupCallMediaChanged is returned when the call's media is not the one the caller expects.
+var ErrGroupCallMediaChanged = errors.New("meowcaller: the group call's media changed")
+
+// QueryOngoingGroupCall asks the server where a group call stands; nil, nil
+// when the server no longer has it.
+func (c *Client) QueryOngoingGroupCall(ctx context.Context, callID string, creator types.JID) (*OngoingGroupCall, error) {
+	// Source of truth: datasheets/voip-ongoing-group-join.md (lobby query)
+	if c == nil || c.eng == nil {
+		return nil, errors.New("meowcaller: group call signaling is unavailable")
+	}
+	ongoing, _, err := c.eng.queryOngoingGroupCall(ctx, callID, creator)
+	return ongoing, err
+}
+
+// JoinOngoingGroupCall joins a group call that is already going on.
+func (c *Client) JoinOngoingGroupCall(ctx context.Context, callID string, creator types.JID, video bool) (*Call, error) {
+	// Source of truth: datasheets/voip-ongoing-group-join.md (join accept)
+	if c == nil || c.eng == nil {
+		return nil, errors.New("meowcaller: group call signaling is unavailable")
+	}
+	return c.eng.joinOngoingGroupCall(ctx, callID, creator, video)
+}
+
+func (e *engine) queryOngoingGroupCall(
+	ctx context.Context,
+	callID string,
+	creator types.JID,
+) (*OngoingGroupCall, *groupCallUpdate, error) {
+	// Source of truth: datasheets/voip-ongoing-group-join.md (lobby query and ACK)
+	if err := e.requireRawCallAdapter(); err != nil {
+		return nil, nil, err
+	}
+	requestID := e.nextCallNodeID()
+	node, err := signaling.BuildLobbyQuery(callID, creator, requestID)
+	if err != nil {
+		return nil, nil, err
+	}
+	response, err := e.requestCall(ctx, node, requestID)
+	if err != nil {
+		return nil, nil, err
+	}
+	return ongoingFromLobbyAck(response)
+}
+
+func ongoingFromLobbyAck(response *waBinary.Node) (*OngoingGroupCall, *groupCallUpdate, error) {
+	// Source of truth: datasheets/voip-ongoing-group-join.md (lobby ACK)
+	parsed, ok, err := signaling.ParseInitialGroupCallAck(response)
+	if err != nil {
+		return nil, nil, err
+	}
+	if !ok {
+		return nil, nil, nil
+	}
+	update := groupCallUpdateFromSignaling(*parsed)
+	return &OngoingGroupCall{
+		CallID: update.CallID, Creator: update.CallCreator, GroupJID: update.GroupJID,
+		Video: update.Media == "video", State: groupCallStateFromUpdate(update),
+	}, &update, nil
+}
+
+func (e *engine) ownLID() types.JID {
+	// Source of truth: datasheets/voip-ongoing-group-join.md (call entry like a call-link join)
+	if e.c == nil || e.c.wa == nil || e.c.wa.Store == nil {
+		return types.EmptyJID
+	}
+	return e.c.wa.Store.GetLID()
+}
+
+func (e *engine) joinOngoingGroupCall(ctx context.Context, callID string, creator types.JID, video bool) (*Call, error) {
+	// Source of truth: datasheets/voip-ongoing-group-join.md (join sequence)
+	ongoing, update, err := e.queryOngoingGroupCall(ctx, callID, creator)
+	if err != nil {
+		return nil, err
+	}
+	if update == nil || ongoing.Connected() == 0 {
+		return nil, ErrGroupCallOver
+	}
+	if ongoing.Video != video {
+		return nil, ErrGroupCallMediaChanged
+	}
+	if existing := e.lookup(callID); existing != nil && existing.call != nil {
+		return nil, errors.New("meowcaller: already in this call")
+	}
+	call := &Call{eng: e, id: callID, peer: creator, phase: CallPhaseConnecting}
+	self := e.ownLID()
+	e.mu.Lock()
+	m := e.entry(callID)
+	m.call = call
+	m.group = true
+	m.selfLID = self.String()
+	m.peerLID = creator.String()
+	m.creator = creator
+	m.from = types.NewJID(callID, "call")
+	m.direction = CallDirectionIncoming
+	m.remoteVideo = video
+	m.inviteSelfDevice = groupCallDevice{
+		JID: self, CapabilityVersion: 1,
+		Capability: append([]byte(nil), signaling.CapabilityOffer...),
+	}
+	e.mu.Unlock()
+	e.applyGroupUpdate(*update)
+
+	accept, err := signaling.BuildOngoingGroupJoin(callID, creator, e.nextCallNodeID(), video)
+	if err == nil {
+		err = e.transmitCallNode(ctx, accept)
+	}
+	if err != nil {
+		e.c.log.Warn().Err(err).Str("call_id", callID).Msg("ongoing group call join failed")
+		e.finishCall(callID, "join_failed")
+		return nil, err
+	}
+	e.c.log.Info().Str("call_id", callID).Bool("video", video).
+		Int("connected", ongoing.Connected()).Msg("joined an ongoing group call")
+	e.maybeStartMedia(callID)
+	return call, nil
+}
diff --git a/engine_ongoing_group_test.go b/engine_ongoing_group_test.go
new file mode 100644
