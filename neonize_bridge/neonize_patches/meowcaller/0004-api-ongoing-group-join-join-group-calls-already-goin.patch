+package signaling
+
+import (
+	"fmt"
+
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+)
+
+// BuildLobbyQuery asks the server where a group call stands while this
+// account is not in it.
+func BuildLobbyQuery(callID string, callCreator types.JID, requestID string) (waBinary.Node, error) {
+	// Source of truth: datasheets/voip-ongoing-group-join.md (WhatsApp Web capture, lobby query)
+	if callID == "" || callCreator.IsEmpty() || requestID == "" {
+		return waBinary.Node{}, fmt.Errorf("signaling: build lobby query: incomplete identity")
+	}
+	return callWrap(types.NewJID(callID, "call"), &requestID, waBinary.Node{
+		Tag: "lobby",
+		Attrs: waBinary.Attrs{
+			"call-id":      callID,
+			"call-creator": callCreator,
+			"query":        "1",
+		},
+	}), nil
+}
+
+// BuildOngoingGroupJoin builds the <accept> that joins a group call already
+// going on.
+func BuildOngoingGroupJoin(callID string, callCreator types.JID, requestID string, video bool) (waBinary.Node, error) {
+	// Source of truth: datasheets/voip-ongoing-group-join.md (WhatsApp Web capture, join accept)
+	if callID == "" || callCreator.IsEmpty() || requestID == "" {
+		return waBinary.Node{}, fmt.Errorf("signaling: build ongoing group join: incomplete identity")
+	}
+	accept := BuildAccept(&AcceptParams{
+		CallID:      callID,
+		To:          types.NewJID(callID, "call"),
+		CallCreator: callCreator,
+		AudioRates:  []string{"16000"},
+		Capability:  append([]byte(nil), CapabilityOffer...),
+		Video:       video,
+	})
+	accept.Attrs["id"] = requestID
+	return accept, nil
+}
diff --git a/signaling/ongoing_group_test.go b/signaling/ongoing_group_test.go
