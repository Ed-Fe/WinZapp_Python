@@ -0,0 +1,78 @@
+package signaling
+
+import (
+	"bytes"
+	"testing"
+
+	"go.mau.fi/whatsmeow/types"
+)
+
+func ongoingCreator() types.JID {
+	return types.JID{User: "100001", Server: types.HiddenUserServer, Device: 27}
+}
+
+func TestLobbyQueryMatchesTheCapture(t *testing.T) {
+	node, err := BuildLobbyQuery("CALLID", ongoingCreator(), "REQ1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if node.Tag != "call" || node.Attrs["to"] != types.NewJID("CALLID", "call") || node.Attrs["id"] != "REQ1" {
+		t.Fatalf("envelope %v", node.Attrs)
+	}
+	lobby := node.GetChildren()
+	if len(lobby) != 1 || lobby[0].Tag != "lobby" || lobby[0].Content != nil {
+		t.Fatalf("children %v", lobby)
+	}
+	attrs := lobby[0].Attrs
+	if len(attrs) != 3 || attrs["call-id"] != "CALLID" || attrs["call-creator"] != ongoingCreator() || attrs["query"] != "1" {
+		t.Fatalf("lobby attrs %v", attrs)
+	}
+	if _, err := BuildLobbyQuery("", ongoingCreator(), "REQ1"); err == nil {
+		t.Fatal("a lobby query needs the call id")
+	}
+}
+
+func TestOngoingJoinIsTheCapturedAccept(t *testing.T) {
+	node, err := BuildOngoingGroupJoin("CALLID", ongoingCreator(), "REQ2", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if node.Attrs["to"] != types.NewJID("CALLID", "call") || node.Attrs["id"] != "REQ2" {
+		t.Fatalf("envelope %v", node.Attrs)
+	}
+	accept := node.GetChildren()[0]
+	if accept.Tag != "accept" || accept.Attrs["call-id"] != "CALLID" || accept.Attrs["call-creator"] != ongoingCreator() {
+		t.Fatalf("accept %v", accept)
+	}
+	var tags []string
+	for _, child := range accept.GetChildren() {
+		tags = append(tags, child.Tag)
+	}
+	want := []string{"audio", "net", "encopt", "capability"}
+	if len(tags) != len(want) {
+		t.Fatalf("children %v, want %v", tags, want)
+	}
+	for i := range want {
+		if tags[i] != want[i] {
+			t.Fatalf("children %v, want %v", tags, want)
+		}
+	}
+	audio := accept.GetChildren()[0]
+	if audio.Attrs["enc"] != "opus" || audio.Attrs["rate"] != "16000" {
+		t.Fatalf("audio %v", audio.Attrs)
+	}
+	capability := accept.GetChildren()[3]
+	if capability.Attrs["ver"] != "1" || !bytes.Equal(capability.Content.([]byte), CapabilityOffer) {
+		t.Fatalf("capability %v", capability)
+	}
+	video, err := BuildOngoingGroupJoin("CALLID", ongoingCreator(), "REQ3", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if child := video.GetChildren()[0].GetChildren()[1]; child.Tag != "video" {
+		t.Fatalf("a video join advertises video, got %s", child.Tag)
+	}
+	if _, err := BuildOngoingGroupJoin("CALLID", types.EmptyJID, "REQ1", false); err == nil {
+		t.Fatal("a join needs the creator")
+	}
+}
