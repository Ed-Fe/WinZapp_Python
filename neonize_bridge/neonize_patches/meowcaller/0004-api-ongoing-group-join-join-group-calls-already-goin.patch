@@ -0,0 +1,111 @@
+package meowcaller
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/rs/zerolog"
+	waBinary "go.mau.fi/whatsmeow/binary"
+	"go.mau.fi/whatsmeow/types"
+)
+
+func lobbyUser(user, state string) waBinary.Node {
+	jid := types.NewJID(user, types.HiddenUserServer)
+	return waBinary.Node{Tag: "user", Attrs: waBinary.Attrs{"jid": jid, "state": state}, Content: []waBinary.Node{
+		{Tag: "device", Attrs: waBinary.Attrs{"jid": jid}},
+	}}
+}
+
+func lobbyAck(media string, users ...waBinary.Node) *waBinary.Node {
+	return &waBinary.Node{Tag: "ack", Attrs: waBinary.Attrs{"class": "call", "type": "lobby"}, Content: []waBinary.Node{{
+		Tag: "group_info",
+		Attrs: waBinary.Attrs{
+			"group-jid": types.NewJID("120363000000000001", types.GroupServer), "call-creator": creatorJID(),
+			"call-id": "GCID", "transaction-id": "111", "media": media, "connected-limit": "32",
+		},
+		Content: users,
+	}}}
+}
+
+func TestTheLobbyAckGivesTheRosterAndItsConnectedPeople(t *testing.T) {
+	ongoing, update, err := ongoingFromLobbyAck(lobbyAck("audio",
+		lobbyUser("1001", "invited"), lobbyUser("1002", "connected"), lobbyUser("1003", "receipt")))
+	if err != nil || ongoing == nil || update == nil {
+		t.Fatalf("ongoing %v update %v err %v", ongoing, update, err)
+	}
+	if ongoing.CallID != "GCID" || ongoing.Video || ongoing.Connected() != 1 || len(ongoing.State.Participants) != 3 {
+		t.Fatalf("ongoing %+v", ongoing)
+	}
+	if ongoing.GroupJID.Server != types.GroupServer || update.TransactionID != 111 {
+		t.Fatalf("group %v transaction %d", ongoing.GroupJID, update.TransactionID)
+	}
+	video, _, _ := ongoingFromLobbyAck(lobbyAck("video", lobbyUser("1002", "connected")))
+	if !video.Video {
+		t.Fatal("a video call's lobby says video")
+	}
+	over, update, err := ongoingFromLobbyAck(&waBinary.Node{Tag: "ack", Attrs: waBinary.Attrs{"type": "lobby"}})
+	if over != nil || update != nil || err != nil {
+		t.Fatalf("a call the server no longer has: %v %v %v", over, update, err)
+	}
+}
+
+func ongoingTestEngine(ack *waBinary.Node, sendErr error) (*engine, *[]waBinary.Node) {
+	c := &Client{log: zerolog.Nop()}
+	c.eng = newEngine(c)
+	var sent []waBinary.Node
+	c.eng.requestCallNode = func(_ context.Context, node waBinary.Node, _ string) (*waBinary.Node, error) {
+		sent = append(sent, node)
+		return ack, nil
+	}
+	c.eng.sendCallNode = func(_ context.Context, node waBinary.Node) error {
+		sent = append(sent, node)
+		return sendErr
+	}
+	return c.eng, &sent
+}
+
+func TestJoiningAnOngoingCallAsksTheLobbyThenAcceptsOnce(t *testing.T) {
+	eng, sent := ongoingTestEngine(lobbyAck("audio", lobbyUser("1002", "connected")), nil)
+	call, err := eng.joinOngoingGroupCall(context.Background(), "GCID", creatorJID(), false)
+	if err != nil || call == nil {
+		t.Fatalf("join: %v", err)
+	}
+	if len(*sent) != 2 || (*sent)[0].GetChildren()[0].Tag != "lobby" || (*sent)[1].GetChildren()[0].Tag != "accept" {
+		t.Fatalf("sent %v", *sent)
+	}
+	m := eng.lookup("GCID")
+	if m == nil || !m.group || m.groupUpdate == nil || m.groupUpdate.TransactionID != 111 || m.localVideo {
+		t.Fatalf("call entry %+v", m)
+	}
+	if call.State() != CallPhaseConnecting {
+		t.Fatalf("phase %v", call.State())
+	}
+	if _, err := eng.joinOngoingGroupCall(context.Background(), "GCID", creatorJID(), false); err == nil {
+		t.Fatal("a call already held is not joined again")
+	}
+}
+
+func TestAJoinIsRefusedWhenNobodyIsLeftOrTheMediaChanged(t *testing.T) {
+	eng, sent := ongoingTestEngine(lobbyAck("audio", lobbyUser("1001", "invited")), nil)
+	if _, err := eng.joinOngoingGroupCall(context.Background(), "GCID", creatorJID(), false); !errors.Is(err, ErrGroupCallOver) {
+		t.Fatalf("err %v", err)
+	}
+	if len(*sent) != 1 || eng.lookup("GCID") != nil {
+		t.Fatalf("only the lobby query goes out, nothing is kept: %v", *sent)
+	}
+	eng, _ = ongoingTestEngine(lobbyAck("video", lobbyUser("1002", "connected")), nil)
+	if _, err := eng.joinOngoingGroupCall(context.Background(), "GCID", creatorJID(), false); !errors.Is(err, ErrGroupCallMediaChanged) {
+		t.Fatalf("err %v", err)
+	}
+}
+
+func TestAFailedAcceptLeavesNoCallBehind(t *testing.T) {
+	eng, _ := ongoingTestEngine(lobbyAck("audio", lobbyUser("1002", "connected")), errors.New("socket closed"))
+	if _, err := eng.joinOngoingGroupCall(context.Background(), "GCID", creatorJID(), false); err == nil {
+		t.Fatal("the accept failed")
+	}
+	if eng.lookup("GCID") != nil {
+		t.Fatal("the call entry must be finished")
+	}
+}
