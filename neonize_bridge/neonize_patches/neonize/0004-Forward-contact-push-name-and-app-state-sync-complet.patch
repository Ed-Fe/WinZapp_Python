From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <gabarrios2006@gmail.com>
Date: Mon, 26 Oct 2026 01:23:01 -0300
Subject: [PATCH 4/5] Forward contact, push name and app state sync complete
 events

whatsmeow already dispatches them; neonize did not pass them to Python:

- ContactUpdate (54): a contact saved, renamed or removed in the phone's
  address book (events.Contact, an app state ContactAction);
- PushNameUpdate (55): a user's push name changed (events.PushName);
- AppStateSyncComplete (56): a full sync of an app state collection
  finished (events.AppStateSyncComplete).

A full sync (right after pairing) does not emit ContactUpdate: whatsmeow
writes those names to the contact store in bulk. AppStateSyncComplete for
critical_unblock_low is the moment they are there to read.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 goneonize/Neonize.proto          | 23 +++++++++++++++++
 goneonize/defproto/Neonize.proto | 23 +++++++++++++++++
 goneonize/main.go                | 43 ++++++++++++++++++++++++++++++++
 neonize/aioze/events.py          |  6 +++++
 neonize/events.py                |  6 +++++
 5 files changed, 101 insertions(+)

diff --git a/goneonize/Neonize.proto b/goneonize/Neonize.proto
index 8cf0cb3..a2b1aaf 100644
--- a/goneonize/Neonize.proto
+++ b/goneonize/Neonize.proto
@@ -956,6 +956,29 @@ message MessageStar { //53
     optional WAWebProtobufSyncAction.StarAction Action = 6;
     required bool FromFullSync = 7;
 }
+// Contact saved, renamed or removed in the phone's address book (app state
+// sync). Not emitted for the contacts of a full sync: those reach the
+// contact store in bulk, and AppStateSyncComplete says when.
+message ContactUpdate { //54
+    required JID JID = 1;
+    required int64 Timestamp = 2;
+    optional WAWebProtobufSyncAction.ContactAction Action = 3;
+    required bool FromFullSync = 4;
+}
+// A user's push name changed, noticed on one of their messages.
+message PushNameUpdate { //55
+    required JID JID = 1;
+    optional JID JIDAlt = 2;
+    required string OldPushName = 3;
+    required string NewPushName = 4;
+}
+// A full sync of an app state collection finished (Name is the collection,
+// e.g. critical_unblock_low, which carries the address book's names).
+message AppStateSyncComplete { //56
+    required string Name = 1;
+    required uint64 Version = 2;
+    required bool Recovery = 3;
+}
 message UpdateGroupParticipantsReturnFunction {
     optional string Error = 1;
     repeated GroupParticipant participants = 2;
diff --git a/goneonize/defproto/Neonize.proto b/goneonize/defproto/Neonize.proto
index 8cf0cb3..a2b1aaf 100644
--- a/goneonize/defproto/Neonize.proto
+++ b/goneonize/defproto/Neonize.proto
@@ -956,6 +956,29 @@ message MessageStar { //53
     optional WAWebProtobufSyncAction.StarAction Action = 6;
     required bool FromFullSync = 7;
 }
+// Contact saved, renamed or removed in the phone's address book (app state
+// sync). Not emitted for the contacts of a full sync: those reach the
+// contact store in bulk, and AppStateSyncComplete says when.
+message ContactUpdate { //54
+    required JID JID = 1;
+    required int64 Timestamp = 2;
+    optional WAWebProtobufSyncAction.ContactAction Action = 3;
+    required bool FromFullSync = 4;
+}
+// A user's push name changed, noticed on one of their messages.
+message PushNameUpdate { //55
+    required JID JID = 1;
+    optional JID JIDAlt = 2;
+    required string OldPushName = 3;
+    required string NewPushName = 4;
+}
+// A full sync of an app state collection finished (Name is the collection,
+// e.g. critical_unblock_low, which carries the address book's names).
+message AppStateSyncComplete { //56
+    required string Name = 1;
+    required uint64 Version = 2;
+    required bool Recovery = 3;
+}
 message UpdateGroupParticipantsReturnFunction {
     optional string Error = 1;
     repeated GroupParticipant participants = 2;
diff --git a/goneonize/main.go b/goneonize/main.go
index a48b164..8a4dbca 100644
--- a/goneonize/main.go
+++ b/goneonize/main.go
@@ -1374,6 +1374,49 @@ func Neonize(db *C.char, id *C.char, JIDByte *C.uchar, JIDSize C.int, newDevice
 				}
 				eventChan <- &messageEvent
 			}
+		case *events.Contact:
+			if _, ok := subscribers[54]; ok {
+				contact := defproto.ContactUpdate{
+					JID:          utils.EncodeJidProto(v.JID),
+					Timestamp:    proto.Int64(v.Timestamp.Unix()),
+					Action:       v.Action,
+					FromFullSync: proto.Bool(v.FromFullSync),
+				}
+				messageEvent := MessageEvent{
+					eventType: 54,
+					message:   &contact,
+				}
+				eventChan <- &messageEvent
+			}
+		case *events.PushName:
+			if _, ok := subscribers[55]; ok {
+				pushName := defproto.PushNameUpdate{
+					JID:         utils.EncodeJidProto(v.JID),
+					OldPushName: proto.String(v.OldPushName),
+					NewPushName: proto.String(v.NewPushName),
+				}
+				if !v.JIDAlt.IsEmpty() {
+					pushName.JIDAlt = utils.EncodeJidProto(v.JIDAlt)
+				}
+				messageEvent := MessageEvent{
+					eventType: 55,
+					message:   &pushName,
+				}
+				eventChan <- &messageEvent
+			}
+		case *events.AppStateSyncComplete:
+			if _, ok := subscribers[56]; ok {
+				complete := defproto.AppStateSyncComplete{
+					Name:     proto.String(string(v.Name)),
+					Version:  proto.Uint64(v.Version),
+					Recovery: proto.Bool(v.Recovery),
+				}
+				messageEvent := MessageEvent{
+					eventType: 56,
+					message:   &complete,
+				}
+				eventChan <- &messageEvent
+			}
 		case *events.RotateADVSecret:
 			if _, ok := subscribers[45]; ok {
 				rot := defproto.RotateADVSecret{
