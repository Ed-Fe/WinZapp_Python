From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gustavo Almeida Barrios <gabarrios2006@gmail.com>
Date: Mon, 26 Oct 2026 01:21:12 -0300
Subject: [PATCH 1/4] build: refuse SPR group send, which the pinned whatsmeow
 cannot do

neonize 0.6.0's SendSPRMessage sets SendRequestExtra.GroupParticipants
and RotateGroupSenderKey, which no released whatsmeow has: 0.6.0 does not
build against its own go.mod pin (its release has no binaries). Dropping
the fields would send the targeted text to the whole group, so the call
refuses after validating its input, until the pin has them.
---
 goneonize/main.go | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/goneonize/main.go b/goneonize/main.go
index dcf69de..b28ff0c 100644
--- a/goneonize/main.go
+++ b/goneonize/main.go
@@ -433,6 +433,13 @@ func SendSPRMessage(id *C.char, groupByte *C.uchar, groupSize C.int, targetsByte
 		return_.Error = proto.String("SPR requires at least one unique target")
 		return ProtoReturnV3(&return_)
 	}
+	// WinZapp: SPR needs whatsmeow's SendRequestExtra.GroupParticipants and
+	// RotateGroupSenderKey, which no released whatsmeow has (neonize 0.6.0 was
+	// written against an unreleased one and does not build with its own pin).
+	// Sending without them would deliver the targeted text to the whole group,
+	// so the call is refused until the pinned whatsmeow carries them.
+	return_.Error = proto.String("SPR group send is not available: the pinned whatsmeow has no per-participant group send")
+	return ProtoReturnV3(&return_)
 
 	secret := make([]byte, 32)
 	if _, err := cryptorand.Read(secret); err != nil {
@@ -464,9 +471,9 @@ func SendSPRMessage(id *C.char, groupByte *C.uchar, groupSize C.int, targetsByte
 		},
 	}
 	extra := whatsmeow.SendRequestExtra{
-		ID:                   messageID,
-		GroupParticipants:    participants,
-		RotateGroupSenderKey: true,
+		ID: messageID,
+		// GroupParticipants and RotateGroupSenderKey belong here once the
+		// pinned whatsmeow has them (see the refusal above).
 	}
 	response, err := client.SendMessage(ctx, group, &message, extra)
 	if err != nil {
